PORT=3000
DATABASE_URL="file:./dev.db"

# MinerU API 配置
MINERU_TOKEN=your_mineru_api_token
MINERU_BASE_URL=https://mineru.net/api/v4

# 可选：非文字元素顺序排序 AI（用于修正图表展示顺序）
# 仅当 URL 和 API Key 都填写时启用
NON_TEXT_ORDER_AI_URL=https://open.bigmodel.cn/api/paas/v4
NON_TEXT_ORDER_AI_API_KEY=your_non_text_order_ai_api_key
NON_TEXT_ORDER_AI_MODEL=GLM-4.5-Flash
NON_TEXT_ORDER_AI_TIMEOUT_MS=45000
